# Fetch from Flux's settings (fetch_flux.sh sources this from the data directory, $DATA; on the laptop it reads it
# over ssh, $DATA being the data directory's Perlmutter path). Values already in the environment win.
FLUX_HOST=${FLUX_HOST:-<your Flux user name>@flux.pppl.gov}
FLUX_PY=${FLUX_PY:-<a python on Flux with numpy and h5py>}
FLUX_TOOL=${FLUX_TOOL:-$DATA/../nstxu_sim_init_workflow/tools/extract_slim_h5.py}
# Optional (TRANSP, flux_transp.py): the sim-init workflow's candidate CSV whose TRANSP_RUN_ID is the run taken for a
# shot it lists (unset: FLUX_TOOL's workflow's code/elong_tri_scan_pre_shape_candidates_latest.csv; empty: none, every
# shot by the rule); this viewer's flux_transp.py on Perlmutter (needed only when fetch_flux.sh runs on the laptop);
# TRANSP's archive on Flux; the MDSplus dumps' directory on Flux (unset: extract_slim_h5.py's two PPPL ones).
#FLUX_TRANSP_CSV=$DATA/../nstxu_sim_init_workflow/code/elong_tri_scan_pre_shape_candidates_latest.csv
#FLUX_TRANSP_TOOL=<the viewer directory on Perlmutter>/flux_transp.py
#FLUX_TRANSP_ROOT=/p/transparch/result/NSTU
#FLUX_H5_ROOT=/p/nstx_experimental_data/mdsplus/NSTXU
