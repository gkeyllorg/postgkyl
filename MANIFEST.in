include postgkyl-build.toml
include scripts/gkeyll_config.py
include scripts/build_gkeyll.py
include scripts/build_gkeyll.sh
include scripts/update_gkeyll.sh
include scripts/gkeyll-branch
include scripts/gkeyll-modules
include scripts/smoke_wheel.sh
include scripts/check_wheel.py
include src/postgkyl/gpython/csrc/_gpythonmodule.c

# These are generated while building a wheel.  Never let the order of local
# release commands leak a platform binary or stale provenance into an sdist.
exclude src/postgkyl/gpython/_build_info.py
exclude src/postgkyl/gpython/_build_info.json
exclude src/postgkyl/gpython/_gpython*.so
exclude src/postgkyl/gpython/libg0*.so
