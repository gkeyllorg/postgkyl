# Fetch from Flux's settings (fetch_flux.sh sources this from the data directory, $DATA; on the laptop it reads it
# over ssh, $DATA being the data directory's Perlmutter path). Values already in the environment win.
FLUX_HOST=${FLUX_HOST:-<your Flux user name>@flux.pppl.gov}
FLUX_PY=${FLUX_PY:-<a python on Flux with h5py>}
FLUX_TOOL=${FLUX_TOOL:-$DATA/../nstxu_sim_init_workflow/tools/extract_slim_h5.py}
